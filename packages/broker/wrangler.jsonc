{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bobnet-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served on the account's workers.dev hostname behind Cloudflare Access;
  // the Worker also verifies the Access JWT, so it fails closed without it.
  "workers_dev": true,
  "preview_urls": false,
  // The dashboard. Every request runs the Worker first, so the Access JWT is
  // checked before any file is served.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "BROKER", "class_name": "Broker" },
      // Every project's board (ADR 0001 §1): its own object, so it restores on its own.
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Broker"] },
    { "tag": "v2", "new_sqlite_classes": ["Board"] }
  ],
  "observability": { "enabled": true }
}
