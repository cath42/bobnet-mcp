{
  "name": "@bobnet/supervisor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Per-laptop BobNet supervisor: runs role agents headless on the Claude Agent SDK, routes their approvals and questions, and serves the orchestrator's tools.",
  "bin": {
    "bobnet-supervisor": "./src/bin.ts"
  },
  "scripts": {
    "start": "node src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@anthropic-ai/sdk": "^1.3.0",
    "@bobnet/client": "workspace:*",
    "@bobnet/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
